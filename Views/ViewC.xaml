<UserControl x:Class="ToolCollisionCalibration.Views.ViewC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ToolCollisionCalibration.Views"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="1000">
    <UserControl.Resources>
        <Style x:Key="CalButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1565C0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#BDBDBD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- IO按钮样式 -->
        <Style x:Key="IOButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="16,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#388E3C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2E7D32"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#BDBDBD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="轴号" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="命令位置" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="反馈位置" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="3" Text="规划速度" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="4" Text="运动状态" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="5" Text="回零状态" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="6" Text="正向点动" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="7" Text="反向点动" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="8" Text="停止" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="9" Text="回零" FontWeight="Bold" HorizontalAlignment="Center"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding AxisItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding AxisName}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Dpos, StringFormat=F2}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Mpos, StringFormat=F2}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding Speed, StringFormat=F2}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{Binding StatusText}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding StatusColor}"/>
                                <TextBlock Grid.Column="5" Text="{Binding HomeStatusText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                <Button Grid.Column="6" Content="+" Width="50" Height="28" 
                                        MouseLeftButtonDown="BtnJogForward_MouseLeftButtonDown"
                                        MouseLeftButtonUp="BtnJog_MouseLeftButtonUp"
                                        Tag="{Binding AxisNumber}"/>
                                <Button Grid.Column="7" Content="-" Width="50" Height="28"
                                        MouseLeftButtonDown="BtnJogReverse_MouseLeftButtonDown"
                                        MouseLeftButtonUp="BtnJog_MouseLeftButtonUp"
                                        Tag="{Binding AxisNumber}"/>
                                <Button Grid.Column="8" Content="停止" Width="50" Height="28" 
                                        Click="BtnStop_Click" Tag="{Binding AxisNumber}"/>
                                <Button Grid.Column="9" Content="回零" Width="50" Height="28" 
                                        Click="BtnHome_Click" Tag="{Binding AxisNumber}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Separator Margin="0,10,0,10"/>

                <TextBlock Text="轴参数设置" FontSize="14" FontWeight="Bold" Margin="0,10,0,5"/>

                <ItemsControl ItemsSource="{Binding AxisItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,3,0,3" BorderBrush="Gray" BorderThickness="1" Padding="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Text="{Binding AxisName}" FontWeight="Bold" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1" Grid.Row="0" Text="脉冲当量:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" Grid.Row="0" Text="{Binding Param.Units, StringFormat=F2}" Width="70" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Grid.Row="0" Text="units/mm" VerticalAlignment="Center" FontSize="10"/>

                                    <TextBlock Grid.Column="5" Grid.Row="0" Text="最小速度:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="6" Grid.Row="0" Text="{Binding Param.Lspeed, StringFormat=F2}" Width="70" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="7" Grid.Row="0" Text="units/s" VerticalAlignment="Center" FontSize="10"/>

                                    <TextBlock Grid.Column="9" Grid.Row="0" Text="运行速度:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="10" Grid.Row="0" Text="{Binding Param.Speed, StringFormat=F2}" Width="70" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="11" Grid.Row="0" Text="units/s" VerticalAlignment="Center" FontSize="10"/>

                                    <TextBlock Grid.Column="1" Grid.Row="1" Text="加速度:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" Grid.Row="1" Text="{Binding Param.Accel, StringFormat=F2}" Width="70" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Grid.Row="1" Text="units/s²" VerticalAlignment="Center" FontSize="10"/>

                                    <TextBlock Grid.Column="5" Grid.Row="1" Text="减速度:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="6" Grid.Row="1" Text="{Binding Param.Decel, StringFormat=F2}" Width="70" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="7" Grid.Row="1" Text="units/s²" VerticalAlignment="Center" FontSize="10"/>

                                    <TextBlock Grid.Column="9" Grid.Row="1" Text="S曲线:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="10" Grid.Row="1" Text="{Binding Param.Sramp, StringFormat=F2}" Width="70" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="11" Grid.Row="1" Text="ms" VerticalAlignment="Center" FontSize="10"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 位置设定 -->
                <GroupBox Header="位置设定" FontSize="14" FontWeight="Bold" Margin="0,15,0,5" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Button Grid.Column="0" Grid.Row="0" Content="标定取销钉位置" Width="110" Height="35"
                                Style="{StaticResource CalButtonStyle}"
                                Click="BtnCalPickPos_Click" Margin="0,0,5,5"/>
                        <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding CalPickPosText}" FontFamily="Consolas" FontSize="13" VerticalAlignment="Center" Margin="0,0,0,5"/>

                        <Button Grid.Column="2" Grid.Row="0" Content="标定打销钉位置" Width="110" Height="35"
                                Style="{StaticResource CalButtonStyle}"
                                Click="BtnCalDrivePos_Click" Margin="5,0,0,5"/>
                        <TextBlock Grid.Column="3" Grid.Row="0" Text="{Binding CalDrivePosText}" FontFamily="Consolas" FontSize="13" VerticalAlignment="Center" Margin="0,0,0,5"/>

                        <Button Grid.Column="0" Grid.Row="1" Content="标定旋转位置" Width="110" Height="35"
                                Style="{StaticResource CalButtonStyle}"
                                Click="BtnCalRotatePos_Click" Margin="0,0,5,0"/>
                        <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding CalRotatePosText}" FontFamily="Consolas" FontSize="13" VerticalAlignment="Center"/>

                        <Button Grid.Column="2" Grid.Row="1" Content="标定回来位置" Width="110" Height="35"
                                Style="{StaticResource CalButtonStyle}"
                                Click="BtnCalReturnPos_Click" Margin="5,0,0,0"/>
                        <TextBlock Grid.Column="3" Grid.Row="1" Text="{Binding CalReturnPosText}" FontFamily="Consolas" FontSize="13" VerticalAlignment="Center"/>
                    </Grid>
                </GroupBox>

                <!-- IO控制 -->
                <GroupBox Header="IO控制" FontSize="14" FontWeight="Bold" Margin="0,15,0,5" Padding="10">
                    <ItemsControl>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <Button Content="输出1" Height="36" Margin="5" Style="{StaticResource IOButtonStyle}"/>
                        <Button Content="输出2" Height="36" Margin="5" Style="{StaticResource IOButtonStyle}"/>
                        <Button Content="输出3" Height="36" Margin="5" Style="{StaticResource IOButtonStyle}"/>
                        <Button Content="输出4" Height="36" Margin="5" Style="{StaticResource IOButtonStyle}"/>
                        <Button Content="输出5" Height="36" Margin="5" Style="{StaticResource IOButtonStyle}"/>
                        <Button Content="输出6" Height="36" Margin="5" Style="{StaticResource IOButtonStyle}"/>
                        <Button Content="输出7" Height="36" Margin="5" Style="{StaticResource IOButtonStyle}"/>
                        <Button Content="输出8" Height="36" Margin="5" Style="{StaticResource IOButtonStyle}"/>
                    </ItemsControl>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>
